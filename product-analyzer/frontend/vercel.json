{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gracious-renewal-production-9f45.up.railway.app/api/v1/:path*"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/tienda.html"
    },
    {
      "source": "/tienda",
      "destination": "/tienda.html"
    },
    {
      "source": "/producto/:slug",
      "destination": "/producto.html?slug=:slug"
    },
    {
      "source": "/robots.txt",
      "destination": "https://gracious-renewal-production-9f45.up.railway.app/api/v1/public/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://gracious-renewal-production-9f45.up.railway.app/api/v1/public/sitemap.xml"
    },
    {
      "source": "/((?!api/|admin(?:/|$)|tienda(?:/|$)).*)",
      "destination": "/tienda.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/tienda.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline'; connect-src 'self' https://gracious-renewal-production-9f45.up.railway.app; form-action 'self' https://checkout.wompi.co"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        }
      ]
    }
  ]
}