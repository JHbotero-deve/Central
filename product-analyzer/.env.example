# =========================================================
# Completar con tus credenciales reales y renombrar a ".env"
# =========================================================

# --- Base de datos (no hace falta tocar esto) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=productos_db
DB_USER=productos_user
DB_PASSWORD=productos_pass

# --- Amazon Associates / Creators API ---
# PAAPI5 fue discontinuada por Amazon en 2026; el reemplazo es Creators API,
# que ya no usa Access Key/Secret Key estilo AWS sino Client ID/Secret (OAuth2).
# Sacalas en: affiliate-program.amazon.com/creatorsapi > Onboarding > Registro.
# Requiere al menos 10 ventas calificadas en los últimos 30 días.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG=jh0c35-20
# NA (US/CA/MX/BR) | EU (UK/DE/FR/IT/ES/...) | FE (JP/SG/AU) - define el endpoint de token
AMAZON_REGION=NA
# Marketplace de venta (opcional, default www.amazon.com)
AMAZON_MARKETPLACE=www.amazon.com

# --- TikTok Shop Partner ---
# App Key y App Secret: partner.tiktokshop.com > tu app
# ACCESS_TOKEN y SHOP_CIPHER: se obtienen corriendo app/get_tiktok_token.py (ver README)
TIKTOK_API_KEY=
TIKTOK_API_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_SHOP_CIPHER=

# --- Automatización de Alertas ---
# Crea un bot con @BotFather en Telegram para el TOKEN
# Usa @userinfobot para obtener tu CHAT_ID o el ID de tu canal
BOT_TOKEN=
CHAT_ID=
