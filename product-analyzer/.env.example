# =============================================================================
# Central — variables de entorno de ejemplo
# Copia a .env local o configura en Railway / Vercel. Nunca subas secretos a Git.
# Guía de despliegue: docs/DESPLIEGUE.md
# =============================================================================

# --- Base de datos (obligatoria en API, worker y bot) ---
# Solo PostgreSQL de Railway en producción. No configurar una segunda base.
DATABASE_URL=

# --- Acceso administrativo ---
CENTRAL_ADMIN_EMAIL=
CENTRAL_ADMIN_PASSWORD=
CENTRAL_AUTH_SECRET=
ADMIN_API_KEY=
MONETIZATION_ADMIN_KEY=

# --- API y frontend ---
PUBLIC_STORE_URL=https://central-7ykr.vercel.app
CENTRAL_API_BASE=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://central-7ykr.vercel.app
CATALOG_SYNC_INTERVAL_SECONDS=7200
SCORE_THRESHOLD=50

# --- Telegram (obligatorias en servicio central-telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_INTERVAL=3

# --- Mercado Libre Colombia ---
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=
MELI_TOKEN_ENCRYPTION_KEY=

# --- Amazon ---
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com
AMAZON_CURRENCY=USD

# --- TikTok Shop Creator ---
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_CREATOR_ACCESS_TOKEN=

# --- Wompi Colombia ---
WOMPI_ENVIRONMENT=prod
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CURRENCY=COP
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_REDIRECT_URL=

# --- AliExpress Open Platform / Dropshipping OAuth ---
# Callback exacto en la consola de AliExpress:
ALIEXPRESS_CALLBACK_URL=https://central-7ykr.vercel.app/api/v1/aliexpress/oauth/callback
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# Opcional; si vacío, Central reutiliza MELI_TOKEN_ENCRYPTION_KEY.
ALIEXPRESS_TOKEN_ENCRYPTION_KEY=

# --- Mongo (solo si se usa almacenamiento de imágenes) ---
MONGO_URL=
MONGO_DB_NAME=

# --- Semillas de prueba (NUNCA en producción) ---
# CENTRAL_ALLOW_DEMO_SEED=true
# CENTRAL_ALLOW_WOMPI_TEST_SEED=true
CATALOG_MAX_PUBLISHED_CARDS=350
CATALOG_MIN_AUTO_PUBLISH_SCORE=75
CATALOG_EXPIRY_HIGH_SCORE_HOURS=48
CATALOG_EXPIRY_LOW_SCORE_HOURS=24
