# Base de datos
# Central usa PostgreSQL de Railway. No configurar una segunda base de datos.
DATABASE_URL=

# Mercado Libre Colombia
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=

# Amazon
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com
AMAZON_CURRENCY=USD

# TikTok Shop Creator
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_CREATOR_ACCESS_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_INTERVAL=3

# API y monetización
ALLOWED_ORIGINS=http://localhost:3000
MONETIZATION_ADMIN_KEY=

# Scoring
SCORE_THRESHOLD=50

# Wompi Colombia
WOMPI_ENVIRONMENT=prod
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CURRENCY=COP
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_REDIRECT_URL=

# AliExpress Open Platform / Dropshipping OAuth
# Register this exact callback URL in the AliExpress App Console:
ALIEXPRESS_CALLBACK_URL=https://central-7ykr.vercel.app/api/v1/aliexpress/oauth/callback
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# Optional dedicated Fernet key. If empty, Central uses MELI_TOKEN_ENCRYPTION_KEY.
ALIEXPRESS_TOKEN_ENCRYPTION_KEY=
